{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "not-windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "gcc",
      "hidden": true,
      "inherits": "not-windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "inherits": "not-windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "msvc",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "clang-cl",
      "hidden": true,
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC, Debug",
      "inherits": [
        "gcc",
        "debug"
      ]
    },
    {
      "name": "gcc-release",
      "displayName": "GCC, Release",
      "inherits": [
        "gcc",
        "release"
      ]
    },
    {
      "name": "clang-debug",
      "displayName": "Clang, Debug",
      "inherits": [
        "clang",
        "debug"
      ]
    },
    {
      "name": "clang-release",
      "displayName": "Clang, Release",
      "inherits": [
        "clang",
        "release"
      ]
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC, Debug",
      "inherits": [
        "msvc",
        "debug"
      ]
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC, Release",
      "inherits": [
        "msvc",
        "release"
      ]
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl, Debug",
      "inherits": [
        "clang-cl",
        "debug"
      ]
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl, Release",
      "inherits": [
        "clang-cl",
        "release"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "not-windows",
      "hidden": true,
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC, Debug",
      "configurePreset": "gcc-debug",
      "inherits": "not-windows"
    },
    {
      "name": "gcc-release",
      "displayName": "GCC, Release",
      "configurePreset": "gcc-release",
      "inherits": "not-windows"
    },
    {
      "name": "clang-debug",
      "displayName": "Clang, Debug",
      "configurePreset": "clang-debug",
      "inherits": "not-windows"
    },
    {
      "name": "clang-release",
      "displayName": "Clang, Release",
      "configurePreset": "clang-release",
      "inherits": "not-windows"
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC, Debug",
      "configurePreset": "msvc-debug",
      "inherits": "windows"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC, Release",
      "configurePreset": "msvc-release",
      "inherits": "windows"
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl, Debug",
      "configurePreset": "clang-cl-debug",
      "inherits": "windows"
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl, Release",
      "configurePreset": "clang-cl-release",
      "inherits": "windows"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "not-windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "gcc-debug",
      "displayName": "GCC, Debug",
      "configurePreset": "gcc-debug",
      "inherits": "not-windows"
    },
    {
      "name": "gcc-release",
      "displayName": "GCC, Release",
      "configurePreset": "gcc-release",
      "inherits": "not-windows"
    },
    {
      "name": "clang-debug",
      "displayName": "Clang, Debug",
      "configurePreset": "clang-debug",
      "inherits": "not-windows"
    },
    {
      "name": "clang-release",
      "displayName": "Clang, Release",
      "configurePreset": "clang-release",
      "inherits": "not-windows"
    },
    {
      "name": "msvc-debug",
      "displayName": "MSVC, Debug",
      "configurePreset": "msvc-debug",
      "inherits": "windows"
    },
    {
      "name": "msvc-release",
      "displayName": "MSVC, Release",
      "configurePreset": "msvc-release",
      "inherits": "windows"
    },
    {
      "name": "clang-cl-debug",
      "displayName": "clang-cl, Debug",
      "configurePreset": "clang-cl-debug",
      "inherits": "windows"
    },
    {
      "name": "clang-cl-release",
      "displayName": "clang-cl, Release",
      "configurePreset": "clang-cl-release",
      "inherits": "windows"
    }
  ]
}
